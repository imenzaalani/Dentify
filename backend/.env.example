# --- App ---
APP_NAME=Dentify API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Used by the app (async driver)
DATABASE_URL=postgresql+asyncpg://dentify:dentify@db:5432/dentify
# Used by Alembic (sync driver) — same DB, different driver
DATABASE_URL_SYNC=postgresql+psycopg2://dentify:dentify@db:5432/dentify

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Storage (Phase 1: local disk. Swap for S3 in storage_service.py later) ---
UPLOAD_DIR=/code/uploads

# --- First owner account, created by seed.py ---
SEED_OWNER_EMAIL=owner@dentify.tn
SEED_OWNER_PASSWORD=ChangeMe123!
